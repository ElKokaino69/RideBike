    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^5.24.1"
